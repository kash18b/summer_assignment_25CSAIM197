#include <stdio.h>

int main() {
    int start, end, i, j, flag;

    printf("Enter starting number: ");
    scanf("%d", &start);

    printf("Enter ending number: ");
    scanf("%d", &end);

    if (start < 2) {
        start = 2;
    }

    for (i = start; i <= end; i++) {
        flag = 0;

        for (j = 2; j * j <= i; j++) {
            if (i % j == 0) {
                flag = 1;
                break;
            }
        }

        if (flag == 0) {
            printf("%d ", i);
        }
    }

    return 0;
}