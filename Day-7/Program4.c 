#include <stdio.h>

int reverseHelper(int n, int rev) {
    if (n == 0) {
        return rev;
    }
    return reverseHelper(n / 10, rev * 10 + (n % 10));
}

int reverse(int n) {
    if (n < 0) {
        return -reverseHelper(-n, 0);
    }
    return reverseHelper(n, 0);
}

int main() {
    int n;

    printf("Enter a number: ");
    scanf("%d", &n);

    printf("Reversed number = %d\n", reverse(n));

    return 0;
}