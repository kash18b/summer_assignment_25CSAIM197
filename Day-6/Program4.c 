#include <stdio.h>

int main() {
    int x, n;
    long long result = 1;

    printf("Enter base (x): ");
    scanf("%d", &x);

    printf("Enter exponent (n): ");
    scanf("%d", &n);

    if (n < 0) {
        printf("Negative exponent not supported\n");
        return 0;
    }

    for (int i = 1; i <= n; i++) {
        result *= x;
    }

    printf("Result = %lld\n", result);

    return 0;
}