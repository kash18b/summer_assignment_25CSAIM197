#include <stdio.h>
#include <math.h>

int main() {
    long long binary;
    int digit, base = 1;
    int decimal = 0;

    printf("Enter a binary number: ");
    scanf("%lld", &binary);

    while (binary > 0) {
        digit = binary % 10;
        decimal += digit * base;
        base = base * 2;
        binary = binary / 10;
    }

    printf("Decimal = %d\n", decimal);

    return 0;
}